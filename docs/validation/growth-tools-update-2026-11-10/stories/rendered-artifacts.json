{
  "storyId": "478efb0f284c447d8390c3352ecdd83a",
  "parts": [
    {
      "id": "dbe078b811c646d19197a3c90b8a2c58",
      "duration": 15.72,
      "hasOutput": true,
      "cues": [
        {
          "start": 0,
          "end": 2.44,
          "text": "За день до свадьбы я нашёл на столе"
        },
        {
          "start": 2.44,
          "end": 2.98,
          "text": "записку."
        },
        {
          "start": 3.64,
          "end": 6.26,
          "text": "В ней было всего три слова: не верь"
        },
        {
          "start": 6.26,
          "end": 6.96,
          "text": "фотографиям."
        },
        {
          "start": 7.68,
          "end": 9.8,
          "text": "Я собирался позвонить невесте, но"
        },
        {
          "start": 9.8,
          "end": 11.14,
          "text": "заметил на обороте адрес."
        },
        {
          "start": 11.88,
          "end": 13.76,
          "text": "Там находилась мастерская моего брата."
        },
        {
          "start": 14.06,
          "end": 15.46,
          "text": "Я решил сначала узнать правду."
        }
      ],
      "background": {
        "file_id": "62c78b2bb2af4567bbabae2c24b6e2c1",
        "sha256": "fixture-cars",
        "start": 38.24,
        "end": 53.96,
        "loop": false,
        "name": "Демонстрационный фон cars"
      }
    },
    {
      "id": "240cdbfcb9794d598e4b6a4a846c32f2",
      "duration": 18.84,
      "hasOutput": true,
      "cues": [
        {
          "start": 0,
          "end": 2.6,
          "text": "Брат встретил меня с большой коробкой."
        },
        {
          "start": 3.14,
          "end": 6.02,
          "text": "Внутри лежал восстановленный семейный"
        },
        {
          "start": 6.02,
          "end": 7.86,
          "text": "альбом — наш свадебный подарок."
        },
        {
          "start": 8.7,
          "end": 10.82,
          "text": "Записка оказалась частью сюрприза:"
        },
        {
          "start": 11.28,
          "end": 13.44,
          "text": "старые фотографии специально перепутали."
        },
        {
          "start": 13.96,
          "end": 15.16,
          "text": "Мы вместе рассмеялись."
        },
        {
          "start": 15.88,
          "end": 17.54,
          "text": "Хорошо, что я сначала задал вопрос,"
        },
        {
          "start": 17.76,
          "end": 18.54,
          "text": "а не сделал вывод."
        }
      ],
      "background": {
        "file_id": "62c78b2bb2af4567bbabae2c24b6e2c1",
        "sha256": "fixture-cars",
        "start": 27.926,
        "end": 46.766,
        "loop": false,
        "name": "Демонстрационный фон cars"
      }
    }
  ],
