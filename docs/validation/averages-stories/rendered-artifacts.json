{
  "storyId": "0de919553ccb479292501cf2fe94d4cf",
  "parts": [
    {
      "id": "a50e1944cc29423e97c8cc120b5c1731",
      "duration": 15.72,
      "hasOutput": true,
      "cues": [
        {
          "start": 0,
          "end": 2.44,
          "text": "За день до свадьбы я нашёл на столе"
        },
        {
          "start": 2.44,
          "end": 2.98,
          "text": "записку."
        },
        {
          "start": 3.64,
          "end": 6.28,
          "text": "В ней было всего три слова: не верь"
        },
        {
          "start": 6.36,
          "end": 6.9399999999999995,
          "text": "фотографиям."
        },
        {
          "start": 7.76,
          "end": 9.8,
          "text": "Я собирался позвонить невесте, но"
        },
        {
          "start": 9.8,
          "end": 11.16,
          "text": "заметил на обороте адрес."
        },
        {
          "start": 11.88,
          "end": 13.78,
          "text": "Там находилась мастерская моего брата."
        },
        {
          "start": 14.06,
          "end": 15.46,
          "text": "Я решил сначала узнать правду."
        }
      ],
      "background": {
        "file_id": "117e90ff96014956a7d2914afcd1e9ee",
        "sha256": "fixture-cars",
        "start": 10.361,
        "end": 26.081,
        "loop": false,
        "name": "Демонстрационный фон cars"
      }
    },
    {
      "id": "e454a01b86b54c72aff4dbdcbb3d970b",
      "duration": 18.84,
      "hasOutput": true,
      "cues": [
        {
          "start": 0,
          "end": 2.6,
          "text": "Брат встретил меня с большой коробкой."
        },
        {
          "start": 3.14,
          "end": 6.02,
          "text": "Внутри лежал восстановленный семейный"
        },
        {
          "start": 6.02,
          "end": 7.86,
          "text": "альбом — наш свадебный подарок."
        },
        {
          "start": 8.7,
          "end": 10.82,
          "text": "Записка оказалась частью сюрприза:"
        },
        {
          "start": 11.28,
          "end": 13.44,
          "text": "старые фотографии специально перепутали."
        },
        {
          "start": 13.96,
          "end": 15.16,
          "text": "Мы вместе рассмеялись."
        },
        {
          "start": 15.88,
          "end": 17.54,
          "text": "Хорошо, что я сначала задал вопрос,"
        },
        {
          "start": 17.76,
          "end": 18.54,
          "text": "а не сделал вывод."
        }
      ],
      "background": {
        "file_id": "117e90ff96014956a7d2914afcd1e9ee",
        "sha256": "fixture-cars",
        "start": 16.705,
        "end": 35.545,
        "loop": false,
        "name": "Демонстрационный фон cars"
      }
    }
  ],
